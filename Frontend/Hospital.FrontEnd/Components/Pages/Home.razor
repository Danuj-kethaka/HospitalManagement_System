@page "/"

<PageTitle>Hospital Management</PageTitle>

<div class="container" style="margin-top: 100px;">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header"><i class="fa fa-user-circle" aria-hidden="true"></i>
                           User Login
                        </div>
                        <div class="card-body">
                            <form action="" method="post" id="UploadDocuments" enctype="multipart/form-data">       
                                <div class="mb-6" style="margin-top: 20px;">
                                    <input type="text" name="description" placeholder="Enter Email" id="description" required class="form-control" >   
                                </div>
                                 <div class="mb-6" style="margin-top: 20px;">
                                    <input type="text" name="description" placeholder="Enter Password" id="description" required class="form-control" >   
                                </div>
                                <div class="mb-3" style="margin-top: 20px;">
                                    <button type="submit" class="btn btn-sm btn-primary">Login</button>
                                    <a href="" class="btn btn-sm btn-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>