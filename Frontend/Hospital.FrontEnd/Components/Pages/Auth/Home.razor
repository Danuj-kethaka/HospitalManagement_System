@page "/"
@using Hospital.FrontEnd.Models
@using Microsoft.AspNetCore.Authentication.OAuth

@inject AuthClient authClient
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Hospital Management</PageTitle>

<div class="container" style="margin-top: 100px;">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header"><i class="fa fa-user-circle" aria-hidden="true"></i>
                           User Login
                        </div>
                        <div class="card-body">
                               @if (!string.IsNullOrEmpty(errorMessage)){<div class="alert alert-danger">@errorMessage</div>}
                            <EditForm Model="@loginUser" FormName="LoginForm" OnValidSubmit="HandleLogin"> 
                                <DataAnnotationsValidator/>
                                <ValidationSummary/>      
                                <div class="mb-6" style="margin-top: 20px;">
                                    <InputText placeholder="Enter Email" @bind-Value="loginUser.Email" required class="form-control" />   
                                </div>
                                 <div class="mb-6" style="margin-top: 20px;">
                                    <InputText @bind-Value="loginUser.Password" type="password"  placeholder="Enter Password"  required class="form-control" />   
                                </div>
                                <div class="mb-3" style="margin-top: 20px;">
                                    <button type="submit" class="btn btn-sm btn-primary">Login</button>
                                    <a href="" class="btn btn-sm btn-secondary">Cancel</a>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@code {
   private LoginDetails loginUser = new();
   private string? errorMessage;

   private async Task HandleLogin()
   {
    errorMessage = null;

    var response = await authClient.Login(loginUser);

    if(response.IsSuccessStatusCode)
    {
    var result = await response.Content.ReadFromJsonAsync<TokenResponse>();

    var token = result!.accessToken;

    await JS.InvokeVoidAsync("localStorage.setItem","token", token);

    var user = await authClient.GetCurrentUser(token);

    if(user != null && user.Role == "Admin")
        {
            NavigationManager.NavigateTo("/AdminDashboard");
        }
    else
        {
            NavigationManager.NavigateTo("/userdashboard");
        }
    }
    else
        {
            errorMessage ="Invalid email or password";
        }
    }


   public class TokenResponse
   {
      public string accessToken{get; set;} = string.Empty;
   }
   [Inject] IJSRuntime JS {get; set;} = default!;
}