@page "/registerpage"

@inject AuthClient authClient
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Hospital.FrontEnd.Components.Layout
@layout NavMenu3
@using Microsoft.AspNetCore.Identity


<div class="container" style="margin-top: 100px;">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header"><i class="fa fa-address-book" aria-hidden="true"></i>
                           User Registraion
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(successMessage)){ <div class="alert alert-success">@successMessage</div>}
                            @if (!string.IsNullOrEmpty(errorMessage)){<div class="alert alert-danger">@errorMessage</div>}
                            <EditForm Model="@user"  OnValidSubmit="HandleSubmitAsync" FormName="RegisterForm">
                                <DataAnnotationsValidator/>
                                <ValidationSummary/>       
                                <div class="mb-6" style="margin-top: 20px;">
                                    <InputText id="initials" @bind-Value="user.Initials" placeholder="Enter initials" required class="form-control"/>
                                    <ValidationMessage TValue="string" For="() => user.Initials"/>   
                                </div>
                                <div class="mb-6" style="margin-top: 20px;">
                                    <InputText placeholder="Enter Email" id="email" @bind-Value="user.Email" required class="form-control" />   
                                    <ValidationMessage TValue="string" For="() => user.Email"/>   
                                </div>
                                 <div class="mb-6" style="margin-top: 20px;">
                                    <InputText placeholder="Enter Password" type="password" id="password" @bind-Value="user.Password" required class="form-control" /> 
                                     <ValidationMessage TValue="string" For="() => user.Password"/>     
                                </div>
                                <div class="mb-3" style="margin-top: 20px;">
                                    <button type="submit" class="btn btn-sm btn-primary">Register</button>
                                    <a href="" class="btn btn-sm btn-secondary">Cancel</a>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>


@code{
    private string? successMessage;
    private string? errorMessage;

    private UserDetails user = new UserDetails
    {
        Initials = string.Empty,
        Email = string.Empty,
        Password = string.Empty
    };

    private async Task HandleSubmitAsync()
{
    successMessage = null;

    errorMessage = null;

    HttpResponseMessage? response =
        await authClient.AddUser(user);

    if (response.IsSuccessStatusCode)
    {
        successMessage =
            "Registration successful";

        StateHasChanged();

        await Task.Delay(2000);

        NavigationManager.NavigateTo("/");
    }
    else
    {
        try
        {
            var errors =
                await response.Content
                .ReadFromJsonAsync<List<IdentityError>>();

            if (errors != null && errors.Any())
            {
                errorMessage = string.Join(
                    "\n",
                    errors.Select(x => x.Description));
            }
            else
            {
                errorMessage =
                    "Registration failed.";
            }
        }
        catch
        {
            errorMessage =
                "Registration failed.";
        }
    }
}
}