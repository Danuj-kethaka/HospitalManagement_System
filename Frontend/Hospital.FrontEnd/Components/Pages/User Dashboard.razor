@page "/userdashboard"
@using Hospital.FrontEnd.Components.Layout
@layout NavMenu4
@using Hospital.FrontEnd.Models
@using Hospital.FrontEnd.Clients
@using Microsoft.VisualBasic

@inject AppointmentClient appointmentClient
@inject MedicalRecordClient medicalRecordClient
@inject BillClient billClient
@inject LabResultClient labResultClient
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<div class="container-fluid mt-3">
        <div class="row justify-content">
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                        <i class="fa fa-calendar me-2" aria-hidden="true"></i>
                            <span>Upcoming Appointments</span>
                        </div>

                        <div class="card-body" style="min-height: 90px; max-height: 90px; overflow-y: auto;">

                            @if(isLoadingAppointments)
                            {
                                <p class="text-center">Loading your appointments..</p>
                            }
                            else if(appointments == null || !appointments.Any())
                            {
                                <p class="text-muted text-center">
                                    you have no appointments yet
                                </p>
                            }
                            else
                            {
                                @foreach (var apt in appointments.OrderByDescending(a => a.DateTime))
                                {
                                    <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">

                                        <div>
                                            <div class="fw-bold">
                                                @apt.DoctoreName
                                            </div>

                                            <small class="text-muted">
                                                @apt.DateTime.ToString("dd MMM yyyy")
                                            </small>
                                        </div>

                                        <div>
                                            @if (apt.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                            else if (apt.Status == "Accepted")
                                            {
                                                <span class="badge bg-success">
                                                    Accepted
                                                </span>
                                            }
                                            else if (apt.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                        </div>

                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <i class="fa fa-file-text me-2" aria-hidden="true"></i>
                             <span>Medical Records</span>
                        </div>
                        <div class="card-body" style="min-height: 90px; max-height: 90px; overflow-y: auto;">
                            @if (isLoadingMedicalRecords)
                            {
                                <p class="text-center">Loading medical records...</p>
                            }
                            else if (medicalRecords == null || !medicalRecords.Any())
                            {
                                <p class="text-muted text-center">No medical records found</p>
                            }
                            else
                            {
                                @foreach (var record in medicalRecords.OrderByDescending(r => r.CreatedAt))
                                {
                                    <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">

                                        <div>
                                            <div class="fw-bold text-primary">
                                                @record.Title
                                            </div>

                                            <small class="text-muted">
                                                @record.CreatedAt.ToString("dd MMM yyyy")
                                            </small>
                                        </div>

                                        <span class="badge bg-primary">
                                            Record
                                        </span>

                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                           <i class="fa fa-credit-card-alt me-2" aria-hidden="true"></i>
                            <span>MY Bills</span>
                        </div>
                        <div class="card-body" style="min-height: 90px; max-height: 90px; overflow-y: auto;">
                            @if (isLoadingBills)
                            {
                                <p>Loading bills...</p>
                            }
                            else if (bills == null || !bills.Any())
                            {
                                <p class="text-muted">No bills found</p>
                            }
                            else
                            {
                                @foreach (var b in bills)
                                {
                                    <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">

                                        <div>
                                            <div class="fw-bold">@b.Title</div>
                                            <small class="text-muted">
                                                Rs. @b.Amount
                                            </small>
                                        </div>

                                        @if (b.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <i class="fa fa-flask me-2"></i>
                            <span>Lab Results</span>
                        </div>

                        <div class="card-body" style="max-height: 90px; overflow-y: auto;">

                            @if (isLoadingLabResults)
                            {
                                <p class="text-center">Loading lab results...</p>
                            }
                            else if (labResults == null || !labResults.Any())
                            {
                                <p class="text-muted text-center">No lab results found</p>
                            }
                            else
                            {
                                @foreach (var lab in labResults.OrderByDescending(x => x.CreatedAt))
                                {
                                    <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">

                                        <div>
                                            <div class="fw-bold text-danger">
                                                @lab.Title
                                            </div>

                                            <small class="text-muted">
                                                @lab.CreatedAt.ToString("dd MMM yyyy")
                                            </small>
                                        </div>

                                        <div>

                                            @if (!string.IsNullOrEmpty(lab.FilePath))
                                            {
                                                <a class="btn btn-sm btn-primary"
                                                href="http://localhost:5253/@lab.FilePath"
                                                target="_blank">

                                                    View
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    No File
                                                </span>
                                            }

                                        </div>

                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mt-2">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                           <i class="fa fa-calendar me-2" aria-hidden="true"></i>
                            <span>Book An Appointment</span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(successMessage)) { <div class="alert alert-success">@successMessage</div> }
                            @if (!string.IsNullOrEmpty(errorMessage)) {  <div class="alert alert-danger">@errorMessage</div>}
                            <EditForm Model="newAppointment" OnValidSubmit="HandleBookAppointment" FormName="Appointment">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <div class="mb-3">
                                    <InputSelect @bind-Value="newAppointment.DoctoreName" class="form-control">
                                        <option value="">-- Select Doctor --</option>
                                        <option value="Dr. Silva">Dr. Silva</option>
                                        <option value="Dr. Perera">Dr. Perera</option>
                                        <option value="Dr. Fernando">Dr. Fernando</option>
                                    </InputSelect>
                                    <ValidationMessage For="() => newAppointment.DoctoreName" />
                                </div>

                                <div class="mb-3">
                                    <InputSelect @bind-Value="newAppointment.DepartmentName" class="form-control">
                                        <option value="">-- Select Department --</option>
                                        <option value="Cardiology">Cardiology</option>
                                        <option value="Neurology">Neurology</option>
                                        <option value="Orthopedic">Orthopedic</option>
                                    </InputSelect>
                                    <ValidationMessage For="() => newAppointment.DepartmentName" />
                                </div>

                                    <div class="mb-3">
                                    <InputDate @bind-Value="newAppointment.DateTime"  class="form-control" />
                                </div>

                                <button type="submit"   class="btn btn-primary w-100 mt-3"  disabled="@isLoading">
                                    @(isLoading ? "Booking Appointment..." : "Book Appointment")
                                </button>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5 mt-2">
                <div class="card card-teal mt-3">
                    <div class="card-header">
                        <i class="fa fa-heart"></i>
                        <span>Health Tips</span>
                    </div>
                    <div class="card-body p-0">
                        <img src="./images/HealthTips2.jpg" style="width: 100%; height: 250px; object-fit: cover;">
                    </div>
                </div>
            </div>
           <div class="col-md-3 mt-2">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <i class="fa fa-file-medical me-2"></i>
                            <span>Your Medical Condition</span>
                        </div>

                        <div class="card-body" style="max-height: 250px; min-height: 250px; overflow-y: auto;">

                            @if (isLoadingMedicalRecords)
                            {
                                <p class="text-center">Loading...</p>
                            }
                            else if (medicalRecords == null || !medicalRecords.Any())
                            {
                                <p class="text-muted text-center">
                                    No medical records found
                                </p>
                            }
                            else
                            {
                                @foreach (var r in medicalRecords
                                    .OrderByDescending(x => x.CreatedAt)
                                    .Take(3))
                                {
                                    <div class="border rounded p-2 mb-2">

                                        <div class="fw-bold text-primary">
                                            @r.Title
                                        </div>

                                        <div class="small text-secondary">
                                            @r.Description
                                        </div>

                                        <div class="d-flex justify-content-between mt-1">
                                            <small class="text-muted">
                                                @r.CreatedAt.ToString("dd MMM yyyy")
                                            </small>

                                            <span class="text-primary">
                                                <i class="fa fa-heartbeat me-1"></i>
                                            </span>
                                        </div>

                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <span>My Appointments</span>
                        </div>
                        <div class="card-body" style="max-height: 70px; overflow-y: auto;">
                            @if (isLoadingAppointments)
                                {
                                    <p class="text-center">Loading your appointments...</p>
                                }
                                else if (appointments == null || !appointments.Any())
                                {
                                    <p class="text-muted text-center">You have no appointments yet.</p>
                                }
                                else
                                {
                           <div class="table-responsive">
                            <table class="table table-hover">
                                <tbody>
                                    @foreach (var apt in appointments.OrderByDescending(a => a.DateTime))
                                    {
                                        <tr>
                                            <td><strong>@apt.DoctoreName</strong></td>
                                            <td>@apt.DepartmentName</td>
                                            <td>@apt.DateTime.ToString("dd MMM yyyy  hh:mm tt")</td>
                                             <td>
                                                @if (apt.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else if (apt.Status == "Accepted")
                                                {
                                                    <span class="badge bg-success">Accepted</span>
                                                }
                                                else if (apt.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <span>Billing Summary</span>
                        </div>

                        <div class="card-body" style="max-height: 70px; overflow-y: auto;">

                            @if (isLoadingBills)
                            {
                                <p class="text-center">Loading billing summary...</p>
                            }
                            else
                            {
                                var totalBills = bills?.Count ?? 0;

                                var totalAmount = bills?.Sum(x => x.Amount) ?? 0;

                                var pendingBills = bills?
                                    .Count(x => x.Status == "Pending") ?? 0;

                                var paidBills = bills?
                                    .Count(x => x.Status == "Paid") ?? 0;

                                <div class="border rounded p-2 mb-2">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-success">Total Amount</span>
                                        <strong class="text-success">Rs. @totalAmount</strong>
                                    </div>
                                </div>    
                            }

                        </div>
                    </div>
                </div>
            </div>
             <div class="col-md-9">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <span>Notification</span>
                        </div>
                         <div class="card-body" style="max-height: 70px; overflow-y: auto;">
                                <p class="text-muted text-center">You have no notification yet.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card mt-3">
                    <div class="card card-teal">
                        <div class="card-header">
                            <span>Hospital Info</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-6 ">
                                <label for="Info" style="color: rgb(227, 13, 42);"> 📍 Location : Talagala Rd, Pannipitiya </label>
                            </div>
                             <div class="mb-6 mt-2">
                                <label for="Info" style="color: rgb(227, 13, 42);"> ☎️ (112) 001122 </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@code {
    private CreateAppointment newAppointment = new()
    {
        DateTime = DateTime.Today
    };
    private List<Appointment>? appointments;
    private string? successMessage;
    private string? errorMessage;
    private bool isLoading = false;
    private bool isLoadingAppointments = true;
    private List<MedicalRecord>? medicalRecords;
    private bool isLoadingMedicalRecords = true;
    private List<Bill>? bills;
    private bool isLoadingBills = true;
    private List<LabResult>? labResults;
    private bool isLoadingLabResults = true;
     

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadMyAppointments();
            await LoadMedicalRecords();
            await LoadMyBills();
            await LoadMyLabResults();
            isLoadingAppointments = false;
            isLoadingMedicalRecords = false;
            StateHasChanged();
        }
    }

    private async Task LoadMedicalRecords()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (!string.IsNullOrWhiteSpace(token))
            {
                medicalRecords = await medicalRecordClient.GetMyMedicalRecordsAsync(token);
            }
            else
            {
                medicalRecords = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            medicalRecords = new();
        }
    }

    private async Task ClearMessagesAfterDelay()
    {
        await Task.Delay(3000); 

        successMessage = null;
        errorMessage = null;

        StateHasChanged();
    }

    private async Task HandleBookAppointment()
    {
        successMessage = null;
        errorMessage = null;
        isLoading = true;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "You are not logged in. Please login again.";
                return;
            }

            var response = await appointmentClient.CreateAppointmentAsync(newAppointment, token);
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "✅ Appointment booked successfully!";
                    newAppointment = new CreateAppointment();
                    await LoadMyAppointments();

                    _ = ClearMessagesAfterDelay(); 
                }
                else
                {
                    errorMessage = "Failed to book appointment. Please try again.";
                    _ = ClearMessagesAfterDelay(); 
                }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMyAppointments()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (!string.IsNullOrWhiteSpace(token))
            {
                appointments = await appointmentClient.GetMyAppointmentsAsync(token);
                
            }
            else
            {
                appointments = new();
            }
        }
        catch
        {
            appointments = new();
        }
    }

    private async Task LoadMyBills()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

        if (!string.IsNullOrWhiteSpace(token))
        {
            bills = await billClient.GetMyBillsAsync(token);
        }
        else
        {
            bills = new();
        }

        isLoadingBills = false;
    }

    private async Task LoadMyLabResults()
    {
        try
        {
            var token = await JS.InvokeAsync<string>(
                "localStorage.getItem",
                "token");

            if (!string.IsNullOrWhiteSpace(token))
            {
                labResults = await labResultClient
                    .GetMyLabResultsAsync(token);
            }
            else
            {
                labResults = new();
            }
        }
        catch
        {
            labResults = new();
        }

        isLoadingLabResults = false;
    }


}